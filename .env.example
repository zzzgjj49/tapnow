# Server-only configuration. Do not put credentials in public/.
VIDEO_GENERATION_PROVIDER=byteplus
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
ARK_API_KEY=
# Without TOS, local video references require an HTTPS URL serving this app's /uploads/.
# PUBLIC_BASE_URL=https://your-canvas.example.com
# Text and image generation require their own model service configuration.
# TEXT_GENERATION_API_URL=
# TEXT_GENERATION_API_KEY=
# IMAGE_GENERATION_API_URL=
# IMAGE_GENERATION_API_KEY=

# BytePlus TOS storage (server only; all five fields enable automatic cloud backup).
# Set TOS_STORAGE_ENABLED=0 to disable backup without removing credentials.
TOS_BUCKET=
TOS_REGION=
TOS_ENDPOINT=
TOS_ACCESS_KEY=
TOS_SECRET_KEY=

# Vercel private workspace. Local mode remains available without DATABASE_URL.
# Create a Neon Postgres database in Vercel Storage and connect it to the project.
DATABASE_URL=
# Stable HTTPS deployment domain, without trailing slash.
APP_URL=
# First administrator only. Existing account passwords are never reset on restart.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Local-only optional authentication. Cloud mode always requires login.
# AUTH_ENABLED=1
# QStash wakes background jobs after the browser closes (separate from model API).
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
